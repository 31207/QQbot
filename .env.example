DRIVER=~fastapi+~websockets
HOST=0.0.0.0
PORT=8080

# 点歌记录数据库文件（默认 <项目>/data/song_requests.db）
QQ_SONG_DATA_FILE=
# 每用户每日点歌上限 / 查看记录最多条数
QQ_SONG_DAILY_LIMIT=5
QQ_SONG_RECORD_LIMIT=20
# 超级管理员 QQ 号（管理命令：封禁/解封/封禁列表），JSON 数组格式
SUPERUSERS=[]

# 音乐搜索（Go Music API）
QQ_MUSIC_API_BASE=http://localhost:8081
# 封面缓存目录（默认 <项目>/data/covers）
QQ_MUSIC_COVER_DIR=
# 每页显示条数 / 搜索会话有效期(秒)
QQ_MUSIC_PAGE_SIZE=10
QQ_MUSIC_SESSION_TTL=600

# OneBot v11 连接方式（DRIVER=~fastapi+~websockets，两种可同时启用）
# 【反向 WebSocket（推荐）】NoneBot 作为 WS 服务端，NapCat 反向 WS 地址填：
#     ws://127.0.0.1:8080/onebot/v11/ws
# 【正向 WebSocket】NoneBot 作为客户端连 NapCat 的 WS 服务端，取消注释：
#     ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]
