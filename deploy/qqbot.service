[Unit]
Description=QQ Song Request Bot (NoneBot2)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=qqbot
Group=qqbot
WorkingDirectory=/opt/QQbot
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/QQbot/.venv/bin/python bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
