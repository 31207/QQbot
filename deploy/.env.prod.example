# 生产环境 .env 模板（复制为 /opt/QQbot/.env 后填写真实值，并 chmod 600）
# 注意：本文件含数据库/LLM 占位符，不要直接提交真实密钥。

DRIVER=~fastapi+~websockets
HOST=127.0.0.1
PORT=8080

# OneBot v11 正向 WebSocket：bot 作为客户端连 NapCat 的 WS 服务端。
# 同机部署保持 127.0.0.1；若 bot 与 NapCat 不同机器，改成 <服务器IP>。
# 反向 WS 时改回：给 NapCat 填 ws://<服务器IP>:8080/onebot/v11/ws 并设置 HOST=0.0.0.0
ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]

# 音乐搜索 Go Music API（已在服务器 8081）
QQ_MUSIC_API_BASE=http://127.0.0.1:8081

QQ_SONG_DAILY_LIMIT=5
QQ_SONG_RECORD_LIMIT=20

# PostgreSQL（bot 与 web 共用）。密码用真实值替换 CHANGE_ME。
DATABASE_URL=postgresql+psycopg://qqbot:CHANGE_ME@127.0.0.1:5432/qqbot

# LLM 智能助手
LLM_ENABLED=true
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=CHANGE_ME
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
