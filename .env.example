DRIVER=~fastapi+~websockets
HOST=0.0.0.0
PORT=8080

# 每用户每周点歌上限 / 管理员及以上每日上限 / 歌单最多展示条数
QQ_SONG_WEEK_LIMIT=5
QQ_SONG_ADMIN_DAILY_LIMIT=99
QQ_SONG_RECORD_LIMIT=20

# 歌曲选中通知：检测 DB 间隔（秒，默认 24 小时=86400）+ 每周发送时点（默认周五 19:00）
QQ_SONG_NOTIFY_INTERVAL=86400
QQ_SONG_NOTIFY_WEEKDAY=4
QQ_SONG_NOTIFY_HOUR=19
QQ_SONG_NOTIFY_MINUTE=0

# 数据库连接串（必填，PostgreSQL）：
#   DATABASE_URL=postgresql+asyncpg://user:pass@127.0.0.1:5432/qqbot
DATABASE_URL=

# 音乐搜索（Go Music API）
QQ_MUSIC_API_BASE=http://localhost:8081
# 封面缓存目录（默认 <项目>/data/covers）
QQ_MUSIC_COVER_DIR=
# 每页显示条数 / 搜索会话有效期(秒)
QQ_MUSIC_PAGE_SIZE=10
QQ_MUSIC_SESSION_TTL=600

# OneBot v11 连接方式（DRIVER=~fastapi+~websockets，两种可同时启用）
# 【反向 WebSocket（推荐）】NoneBot 作为 WS 服务端，NapCat 反向 WS 地址填：
#     ws://127.0.0.1:8080/onebot/v11/ws
# 【正向 WebSocket】NoneBot 作为客户端连 NapCat 的 WS 服务端，取消注释：
#     ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]

# LLM 智能助手（可选）。开启后确定性指令照常本地处理，LLM 只负责
# 自然语言兜底 + 回复措辞；LLM 故障不影响「搜索/点歌」等指令。
# 任意 OpenAI 兼容接口均可，例如 DeepSeek / 通义千问 / GLM / Kimi。
LLM_ENABLED=false
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxxxxxx
# LLM_MODEL=deepseek-chat
# LLM_TIMEOUT=30
# LLM_MEMORY_TTL=1800
# LLM_MEMORY_TURNS=12
# LLM_MAX_STEPS=4
