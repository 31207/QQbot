[Unit]
Description=QQ Song Request Web Admin (FastAPI)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=qqbot
Group=qqbot
WorkingDirectory=/opt/QQbot
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/QQbot/.env
# Web 管理台监听端口（host 固定 127.0.0.1，由 nginx 反代对外，无需改成 0.0.0.0）
Environment=WEB_ADMIN_PORT=8600
# 如需管理接口鉴权，放开下面一行并设置 token：
# Environment=WEB_ADMIN_TOKEN=CHANGE_ME
ExecStart=/opt/QQbot/.venv/bin/python web-admin/backend/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
